{
  "name": "opencode-webdav-sync",
  "version": "0.1.0",
  "description": "Manual OpenCode V2 session backups over WebDAV",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./rpc": "./dist/rpc.js"
  },
  "files": [
    "dist",
    "README.md",
    "webdav-sync.example.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:native": "npm run build && node --import tsx scripts/native-smoke.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.2.x"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": { "optional": true }
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@opencode/client": "2.2.6",
    "@opencode/plugin": "2.2.6",
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.18",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
